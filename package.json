{
  "name": "dsh-vision-tool",
  "version": "0.1.0",
  "description": "dsh plugin: vision capability proxy. Routes image understanding for text-only main models to a small multimodal model, and backs off entirely when the active model declares multimodal support (inputModalities includes 'image').",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "prepare": "tsdown && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.6.0"
  }
}